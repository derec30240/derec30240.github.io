%A7%E8%B8%A9%E5%9D%91%E8%AE%B0/</link><pubDate>Mon, 02 Nov 2026 13:01:12 +0800</pubDate><guid>https://derec30240.github.io/posts/blowfish%E4%B8%BB%E9%A2%98%E5%8D%87%E7%BA%A7%E8%B8%A9%E5%9D%91%E8%AE%B0/</guid><description>主题更新后 hugo server 突然起不来，修好构建又在部署阶段倒下。本文记录从 Hugo 版本不兼容到 GitHub Actions token 过期的完整排查过程。</description><media:content xmlns:media="http://search.yahoo.com/mrss/" url="https://derec30240.github.io/posts/blowfish%E4%B8%BB%E9%A2%98%E5%8D%87%E7%BA%A7%E8%B8%A9%E5%9D%91%E8%AE%B0/feature.png"/></item><item><title>下课，下一节课</title><link>https://derec30240.github.io/posts/%E4%B8%8B%E8%AF%BE%E4%B8%8B%E4%B8%80%E8%8A%82%E8%AF%BE/</link><pubDate>Tue, 07 Jul 2026 15:13:09 +0800</pubDate><guid>https://derec30240.github.io/posts/%E4%B8%8B%E8%AF%BE%E4%B8%8B%E4%B8%80%E8%8A%82%E8%AF%BE/</guid><description>毕业典礼结束后的第三天，我忽然意识到自己已经“毕业”了，可课表上还有四门考试没打勾。</description><media:content xmlns:media="http://search.yahoo.com/mrss/" url="https://derec30240.github.io/posts/%E4%B8%8B%E8%AF%BE%E4%B8%8B%E4%B8%80%E8%8A%82%E8%AF%BE/feature.png"/></item><item><title>将博客工作流迁移到 WSL2</title><link>https://derec30240.github.io/posts/%E5%B0%86%E5%8D%9A%E5%AE%A2%E5%B7%A5%E4%BD%9C%E6%B5%81%E8%BF%81%E7%A7%BB%E5%88%B0wsl2/</link><pubDate>Sat, 09 May 2026 16:13:44 +0800</pubDate><guid>https://derec30240.github.io/posts/%E5%B0%86%E5%8D%9A%E5%AE%A2%E5%B7%A5%E4%BD%9C%E6%B5%81%E8%BF%81%E7%A7%BB%E5%88%B0wsl2/</guid><description>在 WSL2 的 Arch Linux 中安装配置开发环境，克隆博客源码，并重新跑通 Hugo + Blowfish 的写作与自动部署流程。</description><media:content xmlns:media="http://search.yahoo.com/mrss/" url="https://derec30240.github.io/posts/%E5%B0%86%E5%8D%9A%E5%AE%A2%E5%B7%A5%E4%BD%9C%E6%B5%81%E8%BF%81%E7%A7%BB%E5%88%B0wsl2/feature.png"/></item><item><title>使用 Hugo + GitHub Pages 搭建个人博客</title><link>https://derec30240.github.io/posts/%E4%BD%BF%E7%94%A8hugo+github-pages%E6%90%AD%E5%BB%BA%E4%B8%AA%E4%BA%BA%E5%8D%9A%E5%AE%A2/</link><pubDate>Thu, 17 Jul 2025 23:59:13 +0800</pubDate><guid>https://derec30240.github.io/posts/%E4%BD%BF%E7%94%A8hugo+github-pages%E6%90%AD%E5%BB%BA%E4%B8%AA%E4%BA%BA%E5%8D%9A%E5%AE%A2/</guid><description>从零开始，在 Windows 环境下用 Hugo 与 Blowfish 主题搭建个人博客，并借助 GitHub Actions 自动部署到 GitHub Pages。</description><media:content xmlns:media="http://search.yahoo.com/mrss/" url="https://derec30240.github.io/posts/%E4%BD%BF%E7%94%A8hugo+github-pages%E6%90%AD%E5%BB%BA%E4%B8%AA%E4%BA%BA%E5%8D%9A%E5%AE%A2/feature.jpg"/></item><item><title>关于</title><link>https://derec30240.github.io/about/</link><pubDate>Tue, 15 Jul 2025 21:58:44 +0800</pubDate><guid>https://derec30240.github.io/about/</guid><description>&lt;blockquote&gt;&lt;p&gt;Three passions, simple but overwhelmingly strong, have governed my life: the longing for &lt;strong&gt;love&lt;/strong&gt;, the search for &lt;strong&gt;knowledge&lt;/strong&gt;, and unbearable &lt;strong&gt;pity&lt;/strong&gt; for the suffering of mankind.&lt;/p&gt;</description></item></channel></rss>